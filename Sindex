$("ac").onclick=async function(){await db.from("raven_announcements").delete().neq("id","00000000-0000-0000-0000-000000000000");renderAnn();toast("Announcement cleared")};

/* group creation */
$("gb").onclick=async function(){var ids=Object.keys(sel);$("md").classList.remove("on");if(!ids.length)return;
 if(ids.length===1){openWith(ids[0]);return}
 var mem=[me.id].concat(ids),id="g"+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
 var name=ids.slice(0,3).map(function(i){return P(i).n.split(" ")[0]}).join(", ")+(ids.length>3?" +"+(ids.length-3):"");
 var r=await db.from("raven_chats").insert({id:id,is_group:true,name:name,gi:ids.length+1,members:mem});
 if(r.error){toast("Could not create group");return}
 await db.from("raven_messages").insert({chat_id:id,sender_id:me.id,kind:"sys",body:me.n.split(" ")[0]+" created the group"});
 await loadChats();var c=getC(id);if(c)openC(c)};


/* profile photo */
$("meav2").style.cursor="pointer";
$("meav2").onclick=function(){pick("image/*",function(f){readImg(f,256,"image/jpeg",.8,function(d){saveMe({avatar:d});toast("Profile photo updated")})})};
/* voice notes */
var rec=null,recTimer=null;
function toggleRec(){
 if(rec){rec.stop();return}
 if(!cur){toast("Open a chat first");return}
 if(!navigator.mediaDevices||!window.MediaRecorder){toast("Voice notes are not supported in this browser");return}
 navigator.mediaDevices.getUserMedia({audio:true}).then(function(st){
  var chunks=[],r=new MediaRecorder(st);rec=r;
  r.ondataavailable=function(e){if(e.data.size)chunks.push(e.data)};
  r.onstop=function(){st.getTracks().forEach(function(t){t.stop()});clearTimeout(recTimer);rec=null;$("sd").style.removeProperty("background");syncBtn();
   var b=new Blob(chunks,{type:r.mimeType||"audio/webm"});
   if(b.size<2000){toast("Recording too short");return}
   if(b.size>700000){toast("Voice note too long. Keep it under about 40 seconds.");return}
   var fr=new FileReader();fr.onload=function(){post({k:"aud",m:fr.result})};fr.readAsDataURL(b)};
  r.start();$("sd").style.setProperty("background","#ff4d63","important");toast("Recording… tap the red button to send");
  recTimer=setTimeout(function(){if(rec)rec.stop()},40000)
 },function(){toast("Microphone is blocked. Allow access in your browser.")})}
