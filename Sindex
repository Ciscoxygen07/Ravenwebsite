function sc(v){var p=(v.length>=8)+(/[a-z]/.test(v)&&/[A-Z]/.test(v))+/\d/.test(v)+/[^A-Za-z0-9]/.test(v)+(v.length>=12);return v.length<8||p<=3?0:p==4?1:2}
$("pw").oninput=function(){var v=this.value,m=$("pm"),b=document.querySelectorAll(".meter i");b.forEach(function(i){i.style.background="rgba(255,255,255,.14)"});if(!v){m.textContent="";return}
var s=sc(v),c=["#ff8a9d","#ffc247","#2cf27f"][s],t=["Weak — add 8+ characters, upper & lower case, a number and a symbol","Strong","Very strong"][s];for(var i=0;i<=s;i++)b[i].style.background=c;m.style.color=c;m.textContent=t};
var dm=$("db");dm.max=new Date().toISOString().slice(0,10);
function age(){if(!dm.value)return null;var d=new Date(dm.value),n=new Date(),a=n.getFullYear()-d.getFullYear();if(n<new Date(n.getFullYear(),d.getMonth(),d.getDate()))a--;return a}
dm.onchange=function(){var a=age(),m=$("dm");if(a===null){m.textContent="";return}var good=a>=10&&a<=110;m.className="msg "+(good?"ok":"no");m.textContent=good?"Age: "+a:"For your user credibility, please enter your real age."};

function norm(r){return {gd:r.gender||"",eth:r.ethnicity||"",avatar:r.avatar||"",id:r.id,u:r.username,n:r.full_name||"User",about:r.about||"",gi:r.gi||0,vis:r.vis!==false,sus:!!r.sus,role:r.role||"user",seen:Date.parse(r.seen)||0,joined:Date.parse(r.joined)||0}}
function mm(r){return {id:r.id,f:r.sender_id,k:r.kind,m:r.body,t:Date.parse(r.created_at)||Date.now()}}
function mc(r){return {id:r.id,grp:!!r.is_group,n:r.name||"",gi:r.gi||0,mem:r.members||[],msgs:[],lm:null,unread:0}}
function P(id){return U.filter(function(u){return u.id===id})[0]||{id:id,n:"Deleted user",gi:0,u:""}}
function oth(c){return c.mem.filter(function(i){return i!==me.id})[0]}
function cname(c){return c.grp?c.n:P(oth(c)).n}
function last(c){return c.lm||{k:"t",m:"",t:0,f:""}}
function unread(c){return c.unread||0}
function getC(id){return CH.filter(function(c){return c.id===id})[0]}
function typingNow(c){var t=typ[c.id];return t&&t.u!==me.id&&Date.now()-t.ts<3500?t.u:null}

/* auth */
function tab(n){["in","up"].forEach(function(k){$(k).classList.toggle("on",k==n)});document.querySelectorAll(".tabs button").forEach(function(b){b.classList.toggle("on",b.dataset.t==n)});document.querySelector(".auth").scrollTop=0}
document.querySelectorAll("[data-t]").forEach(function(b){b.onclick=function(){tab(b.dataset.t)}});
document.querySelectorAll(".sw").forEach(function(b){b.onclick=function(){var i=b.previousElementSibling,s=i.type=="password";i.type=s?"text":"password";b.textContent=s?"Hide":"Show"}});
var uok=false,ut;
$("un").oninput=function(){var v=this.value.trim().toLowerCase(),m=$("um");uok=false;clearTimeout(ut);
 if(!v){m.textContent="";return}
 if(!/^[a-z0-9_.]{3,20}$/.test(v)){m.className="msg no";m.textContent="3–20 letters, numbers, . or _";return}
 if(RES.indexOf(v)>-1){m.className="msg no";m.textContent="@"+v+" is reserved";return}
 m.className="msg";m.textContent="Checking…";
 ut=setTimeout(async function(){var r=await db.from("raven_profiles").select("id").eq("username",v);
  if(r.data&&r.data.length){m.className="msg no";m.textContent="@"+v+" is already taken"}else{uok=true;m.className="msg ok";m.textContent="@"+v+" is available"}},300)};
async function loadUsers(){var r=await db.from("raven_profiles").select("*");if(r.data)U=r.data.map(norm);else if(r.error)lastErr=r.error.message;
 if(me){var x=P(me.id);if(!x.u)return logout("Your account was removed"+(lastErr?" (database error: "+lastErr+")":" (no profile found for this login)"));if(x.sus)return logout("Your account has been suspended");me=x}}
async function enter(user){var r=await db.from("raven_profiles").select("*").eq("id",user.id).maybeSingle();
 if(!r.data)return logout("Your account was removed"+(r.error?" (database error: "+r.error.message+")":" (no profile found for this login)"));
 me=norm(r.data);if(me.sus)return logout("This account has been suspended");
 await loadUsers();
 $("mfn").value=me.n;$("mfa").value=me.about;["lp","pw"].forEach(function(i){$(i).value=""});
 cur=null;sel={};renderMe();go("list");ST.classList.add("authed","inapp");beat();
 if(!timers){timers=true;rt();setInterval(poll,1500);setInterval(beat,12000)}
 await loadChats();renderAnn();renderList();renderPeople()}
async function logout(msg){if(msg)sessionStorage.setItem("rv:msg",msg);await db.auth.signOut();location.reload()}
$("lo").onclick=function(){logout()};
$("in").onsubmit=async function(e){e.preventDefault();var m=$("lm"),id=$("li").value.trim().toLowerCase(),pw=$("lp").value;
 if(!id||!pw){m.className="msg no";m.textContent="Enter your email or username and password";return}
 m.className="msg";m.textContent="Logging in…";
 var email=id;
 if(id===ADM_U&&pw===ADM_P)email=ADM_E;
 else if(id.indexOf("@")<0){var r=await db.rpc("raven_email_for_username",{u:id.replace(/^@/,"")});email=r.data;if(!email){m.className="msg no";m.textContent="No account found with that username";return}}
 var res=await db.auth.signInWithPassword({email:email,password:pw});
 if(res.error&&email===ADM_E&&pw===ADM_P){var s=await db.auth.signUp({email:ADM_E,password:ADM_P,options:{data:{username:ADM_U,full_name:"Administrator"}}});if(!s.error)res=await db.auth.signInWithPassword({email:ADM_E,password:ADM_P})}
 if(res.error){m.className="msg no";m.textContent=/invalid/i.test(res.error.message)?"Wrong password":res.error.message;return}
 await enter(res.data.user)};
$("up").onsubmit=async function(e){e.preventDefault();var m=$("sm"),a=age(),g=document.querySelector('input[name=gd]:checked'),em=$("em").value.trim().toLowerCase(),e1;
 if(!$("fn").value.trim()||!$("sn").value.trim())e1="Enter your first name and surname";
 else if(!uok)e1="Choose an available username";
 else if(!g)e1="Select your gender";
 else if(a===null||a<10||a>110)e1="For your user credibility, please enter your real age";
 else if(!/^\S+@\S+\.\S+$/.test(em))e1="Enter a valid email";
 else if(!$("eth").value)e1="Select your ethnicity";
 else if(sc($("pw").value)<1)e1="Your password is too weak — make it stronger";
 if(e1){m.className="msg no";m.textContent=e1;return}
 m.className="msg";m.textContent="Creating account…";
 var res=await db.auth.signUp({email:em,password:$("pw").value,options:{data:{username:$("un").value.trim().toLowerCase(),full_name:$("fn").value.trim()+" "+$("sn").value.trim(),gender:g.value,ethnicity:$("eth").value,dob:dm.value}}});
 if(res.error){m.className="msg no";m.textContent=res.error.message;return}
 if(res.data.session)await enter(res.data.user);
 else{m.className="msg ok";m.textContent="Check your email to confirm, then log in."}};
var pm=sessionStorage.getItem("rv:msg");if(pm){sessionStorage.removeItem("rv:msg");$("lm").className="msg no";$("lm").textContent=pm}

/* realtime, chats and messages */
function rt(){ch=db.channel("raven")
 .on("postgres_changes",{event:"INSERT",schema:"public",table:"raven_messages"},function(p){addMsg(p.new.chat_id,mm(p.new))})
 .on("postgres_changes",{event:"INSERT",schema:"public",table:"raven_chats"},function(){loadChats()})
 .on("postgres_changes",{event:"*",schema:"public",table:"raven_profiles"},function(){loadUsers().then(function(){renderPeople();renderList()})})
 .on("postgres_changes",{event:"INSERT",schema:"public",table:"raven_signals"},function(p){sigQ.push(p.new.payload);db.from("raven_signals").delete().eq("id",p.new.id).then(function(){})})
 .on("postgres_changes",{event:"*",schema:"public",table:"raven_announcements"},function(){renderAnn()})
 .on("broadcast",{event:"typing"},function(p){typ[p.payload.c]={u:p.payload.u,ts:Date.now()}})
 .subscribe()}
async function loadChats(){var r=await db.from("raven_chats").select("*").contains("members",[me.id]);if(r.error)return;
 var list=r.data.map(mc),rd=S.g("rv:read:"+me.id,{});
 await Promise.all(list.map(async function(c){
  var a=await db.from("raven_messages").select("*").eq("chat_id",c.id).order("created_at",{ascending:false}).limit(1);
  if(a.data&&a.data[0])c.lm=mm(a.data[0]);
  var b=await db.from("raven_messages").select("id",{count:"exact",head:true}).eq("chat_id",c.id).neq("sender_id",me.id).gt("created_at",new Date(rd[c.id]||0).toISOString());
  c.unread=b.count||0}));
 CH=list.filter(function(c){return c.lm}).sort(function(a,b){return last(b).t-last(a).t});renderList()}
function markRead(c){var k="rv:read:"+me.id,r=S.g(k,{});r[c.id]=Date.now();S.s(k,r)}
async function openC(c){cur=c;c.unread=0;tray=null;renderTray();markRead(c);
 $("cav").innerHTML=chatAv(c,40);$("cn").textContent=cname(c);$("cv").style.display=$("cp").style.display=c.grp?"none":"";
 head();renderMsgs();go("chat");syncBtn();
 var r=await db.from("raven_messages").select("*").eq("chat_id",c.id).order("created_at",{ascending:true}).limit(300);
 if(r.data&&cur&&cur.id===c.id){c.msgs=r.data.map(mm);renderMsgs()}}
function open(c){openC(c)}
function openWith(uid){var id=[me.id,uid].sort().join("_");openC(getC(id)||{id:id,grp:false,n:"",mem:[me.id,uid],msgs:[],lm:null,unread:0})}
function renderMsgs(){var c=cur;if(!c)return;var el=$("ms"),near=el.scrollHeight-el.scrollTop-el.clientHeight<140,top=el.scrollTop,h="",ld=null,lf=null;
 if(!c.msgs.length)h='<div class="chip">Say hi to '+esc(cname(c).split(" ")[0])+' 👋</div>';
 c.msgs.forEach(function(m){var dl=dayLabel(m.t);if(dl!==ld){h+='<div class="chip">'+dl+'</div>';ld=dl;lf=null}
  if(m.k==="sys"){h+='<div class="chip">'+esc(m.m)+'</div>';lf=null;return}
  var own=m.f===me.id,first=m.f!==lf;lf=m.f;var p=own?me:P(m.f),b,cl="";
  if(m.k==="st"){b=m.m.indexOf("data:")===0?'<img class="stk" src="'+m.m+'" alt="Sticker">':'<span class="stke">'+m.m+'</span>';cl=" nb"}
  else if(m.k==="aud"){b='<audio controls preload="metadata" src="'+m.m+'"></audio>';cl=" nb"}else if(m.k==="img"||m.k==="gif"){b='<img class="pic" src="'+m.m+'" alt="Photo">';cl=" pb"}else b=esc(m.m);
  h+='<div class="r '+(own?"me ":"")+(first?"fi":"")+'">'+(own?"":first?av(p,28):'<span class="sp28"></span>')+'<div class="bub'+cl+'">'+(!own&&c.grp&&first?'<span class="nm" style="color:'+GR[(p.gi||0)%6][0]+'">'+esc(p.n)+'</span>':"")+b+'<span class="tm">'+tm(m.t)+(own?" ✓":"")+'</span></div></div>'});
 var t=typingNow(c);if(t)h+='<div class="r fi">'+av(P(t),28)+'<div class="bub"><div class="td"><i></i><i></i><i></i></div></div></div>';
 el.innerHTML=h;el.scrollTop=near?el.scrollHeight:top}
function addMsg(cid,m){var known=getC(cid),isOpen=cur&&cur.id===cid;
 if(isOpen&&!cur.msgs.some(function(x){return x.id===m.id}))cur.msgs.push(m);
 if(!known){loadChats();return}
 if(!isOpen&&m.f!==me.id)known.unread++;
 known.lm=m;CH.sort(function(a,b){return last(b).t-last(a).t});
 if(isOpen){renderMsgs();markRead(cur)}
 renderList()}
async function post(o){if(!cur||!me)return false;var c=cur;
 if(!c.grp)await db.from("raven_chats").upsert({id:c.id,is_group:false,members:c.mem},{onConflict:"id",ignoreDuplicates:true});
 var r=await db.from("raven_messages").insert({chat_id:c.id,sender_id:me.id,kind:o.k,body:o.m}).select().single();
 if(r.error){toast("Message not sent. Check your connection.");return false}
 addMsg(c.id,mm(r.data));return true}
function send(){var v=$("tx").value.trim();if(!v||!cur)return;$("tx").value="";syncBtn();post({k:"t",m:v}).then(function(ok){if(!ok)$("tx").value=v})}
$("sd").onclick=function(){if($("tx").value.trim())return send();toggleRec()};$("tx").onkeydown=function(e){if(e.key==="Enter")send()};
$("tx").oninput=function(){syncBtn();if(cur&&ch&&Date.now()-lastT>1500){lastT=Date.now();ch.send({type:"broadcast",event:"typing",payload:{c:cur.id,u:me.id,n:me.n}})}};
$("bk").onclick=function(){cur=null;tray=null;go("list")};
$("ms").onclick=function(e){if(e.target.className==="pic"){$("lbi").src=e.target.src;$("lbx").classList.add("on")}};$("lbx").onclick=function(){$("lbx").classList.remove("on")};

/* calls signalling */
function procSig(){var a=sigQ.splice(0);a.forEach(function(m){if(Date.now()-m.ts>60000)return;
 if(m.t==="offer"){if(call||incoming){sigSend(m.from,{t:"end",from:me.id});return}incoming=m;showInc();setTimeout(function(){if(incoming===m){incoming=null;$("inc").className="inc"}},45000)}
 else if(m.t==="answer"){if(call&&call.peer===m.from&&!call.answered){call.answered=1;call.pc.setRemoteDescription(m.sdp).catch(function(){endCall(true)})}}
 else if(m.t==="end"){if(call&&call.peer===m.from){endCall(false);toast("Call ended")}if(incoming&&incoming.from===m.from){incoming=null;$("inc").className="inc"}}})}

/* session loop */
function poll(){if(!me)return;procSig();tick++;var v=ph.dataset.s;
 if(v==="list")renderList();else if(v==="ppl")renderPeople();else if(v==="adm"&&tick%5===0)renderAdmin();
 if(cur&&v==="chat"){var tn=!!typingNow(cur);if(tn||lastTyp){head();renderMsgs()}lastTyp=tn}}
function beat(){if(me)db.from("raven_profiles").update({seen:new Date().toISOString()}).eq("id",me.id).then(function(){})}

/* me */
async function saveMe(patch){var r=await db.from("raven_profiles").update(patch).eq("id",me.id).select().single();if(r.error){toast("Could not save");return}me=norm(r.data);renderMe();renderList()}
$("mfn").oninput=function(e){saveMe({full_name:e.target.value.trim()||"You"})};
$("mfa").oninput=function(e){saveMe({about:e.target.value})};
$("vis").onclick=function(){saveMe({vis:me.vis===false})};

/* admin */
$("adb").onclick=function(){renderAdmin();go("adm")};$("ab").onclick=function(){go("me")};
async function renderAdmin(){var st=await db.rpc("raven_admin_stats");var s=st.data||{users:U.length,online:0,messages:0};
 $("ast").innerHTML=[["Users",s.users],["Online now",s.online],["Messages",s.messages]].map(function(x){return '<div class="stat"><b>'+x[1]+'</b><small>'+x[0]+'</small></div>'}).join("");
 $("au").innerHTML=U.map(function(u){var self=u.id===me.id||u.role==="admin";return '<div class="crow" style="cursor:default">'+av(u,46,u)+'<div class="mid"><b>'+esc(u.n)+(u.role==="admin"?' <span class="tag">Admin</span>':"")+(u.sus?' <span class="tag red">Suspended</span>':"")+'</b><span class="pv">@'+esc(u.u)+'</span><span class="pv">'+(seenMin(u)<0.7?"Online now":pres(u))+'</span></div>'+(self?"":'<div class="ac"><button class="hi" data-sus="'+u.id+'">'+(u.sus?"Restore":"Suspend")+'</button><button class="hi dl" data-del="'+u.id+'">Delete</button></div>')+'</div>'}).join("");
 $("au").querySelectorAll("[data-sus]").forEach(function(b){b.onclick=async function(){var u=P(b.dataset.sus);await db.from("raven_profiles").update({sus:!u.sus}).eq("id",u.id);await loadUsers();renderAdmin()}});
 $("au").querySelectorAll("[data-del]").forEach(function(b){b.onclick=async function(){if(armed!==b.dataset.del){armed=b.dataset.del;b.textContent="Confirm?";setTimeout(function(){armed=null;if(b.isConnected)b.textContent="Delete"},3000);return}armed=null;await db.from("raven_profiles").delete().eq("id",b.dataset.del);await loadUsers();renderAdmin()}})}
async function renderAnn(){var el=$("ann");var r=await db.from("raven_announcements").select("*").order("created_at",{ascending:false}).limit(1);var a=r.data&&r.data[0];
 if(a&&sessionStorage.getItem("rv:annx")!==a.id){el.style.display="";el.innerHTML='<span>📣 '+esc(a.text)+'</span><button aria-label="Dismiss" data-ic="ok"></button>';icons(el);el.querySelector("button").onclick=function(){sessionStorage.setItem("rv:annx",a.id);el.style.display="none"}}else el.style.display="none"}
