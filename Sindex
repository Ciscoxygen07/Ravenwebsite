applyTheme(S.g("rv:theme",window.matchMedia&&window.matchMedia("(prefers-color-scheme: light)").matches?"light":"dark"));
icons();syncBtn();
db.auth.getSession().then(function(r){if(r.data&&r.data.session)enter(r.data.session.user)});
})();
